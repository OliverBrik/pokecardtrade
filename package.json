{
  "name": "newvue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "config:hosting": "node scripts/prepare-hosting-env.mjs",
    "deploy:trading": "firebase deploy --only functions:findTradeMatches,functions:sendTradeProposal,functions:respondToTrade --project pokecardtrade-8cdec",
    "test": "node --test tests/*.test.mjs",
    "lint:check": "oxlint . && eslint .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:marketplace": "node --test tests/marketplace.test.mjs",
    "test:trading": "node --test tests/trading.test.mjs",
    "dev:trading-preview": "vite --config tests/trading-preview.config.mjs --host 127.0.0.1 --port 5174",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "firebase": "^12.19.0",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "eslint": "^10.0.2",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "globals": "^17.3.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
